# News API Configuration (choose one)
# NewsData.io (RECOMMENDED - better free tier: 200 requests/day)
NEWSDATA_API_KEY=your_newsdata_api_key_here

# WorldNewsAPI (alternative - 100 requests/day free tier)
WORLDNEWS_API_KEY=your_worldnews_api_key_here

# Stock Market API Keys
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# OpenAI API (optional - for enhanced sentiment analysis)
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///data/news_stock_analysis.db

# Algorithm Parameters (can be overridden in config.yaml)
SENTIMENT_WEIGHT=1.0
VOLUME_WEIGHT=0.5
ENTITY_WEIGHT=0.3
